#!/usr/bin/env node
// Publishes the private repository's latest release on marktone.app when it carries every installer and the site does not have it yet:
// a public release with the installers under fixed names and their checksums, then the update feed, then the home and download pages
// rendered from it. It writes the site's files in this checkout and leaves committing them to its caller: the publishing workflow, or an
// agent landing through Carson.
//
// Usage: bin/sync
// SOURCE_TOKEN may read wanghailei/marktone's releases; without it, gh's own login reads them. GH_TOKEN, or gh's login, writes this
// repository's releases.
// Exit codes: 0 when marktone.app is level with the latest complete release, or the latest release is not complete yet; 1 when a step
// failed, with what failed.
async function main() {
	const { PRIVATE_REPOSITORY, PUBLIC_REPOSITORY, Releases, Site, Sync } = await import( "../lib/marktone.mjs" )
	const sourceToken = process.env.SOURCE_TOKEN || undefined
	if( process.env.GITHUB_ACTIONS && !sourceToken ) {
		console.error( "The secret MARKTONE_RELEASES_TOKEN is not set, so the private repository's releases cannot be read. Add a token that may read wanghailei/marktone's contents as that secret in this repository's settings, then run the workflow again." )
		process.exit( 1 )
	}
	const sync = new Sync( {
		source: new Releases( { repository: PRIVATE_REPOSITORY, token: sourceToken } ),
		destination: new Releases( { repository: PUBLIC_REPOSITORY } ),
		site: new Site( { folder: require( "node:path" ).resolve( __dirname, ".." ) } ),
	} )
	try {
		console.log( sync.sync() )
	} catch( failure ) {
		console.error( `marktone.app was not updated: ${ failure.message }` )
		process.exit( 1 )
	}
}

main()
