#!/bin/sh
# Runs every test with Node's own test runner and measures how much of lib/ they run, so the site needs no package. Carson runs it before
# landing, and the publishing workflow runs it before it publishes anything. It needs Node 22.8 or later, for the coverage threshold.
#
# Usage: bin/check
# Exit codes: 0 when every test passes and lib/ is at least 90% covered by lines; 1 otherwise.
cd "$( dirname "$0" )/.." || exit 1
exec node --test --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-lines=90 test/*.test.mjs
